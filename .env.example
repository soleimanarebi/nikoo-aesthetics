# Booking platform URL — every "Book Consultation" button on the site
# points to this URL. Replace with your real Consentz booking link.
NEXT_PUBLIC_BOOKING_URL=https://booking.consentz.com/nikoo-aesthetics

# Canonical production site URL — used for SEO metadata, OpenGraph,
# sitemap.xml and robots.txt. Update this to your live domain.
NEXT_PUBLIC_SITE_URL=https://www.nikooaesthetics.co.uk

# ---------------------------------------------------------------------------
# Email (Resend) — server-side only, never exposed to the browser.
# See README.md → "Email System (Booking & Contact Forms)" for full setup
# instructions, including how to create a free Resend account and verify
# your sending domain.
# ---------------------------------------------------------------------------

# Your Resend API key (starts with "re_"). Get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The clinic inbox that receives new booking/enquiry notifications.
ADMIN_EMAIL=nikooaesthetics@gmail.com

# The address emails are sent FROM. Must be on a domain you've verified in
# Resend (e.g. bookings@nikooaesthetics.co.uk) — see the README for how to
# verify a domain. Cannot be a plain Gmail address.
FROM_EMAIL=Nikoo Aesthetics <bookings@nikooaesthetics.co.uk>
